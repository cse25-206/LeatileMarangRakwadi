            <a href="contact.html">Contact</a>

        </div>

        <div class="footer-contact">

            <h3>Contact</h3>

            <p>Email: lattyfitness@gmail.com</p>

            <p>Phone: +267 12345678</p>

            <p>Gaborone, Botswana</p>

        </div>

    </div>

    <hr>

